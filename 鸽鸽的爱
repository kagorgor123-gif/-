package com.privatehub.browser

import android.app.Activity
import android.app.AlertDialog
import android.os.Bundle
import android.view.Gravity
import android.view.View
import android.webkit.CookieManager
import android.webkit.WebChromeClient
import android.webkit.WebView
import android.webkit.WebViewClient
import android.webkit.WebResourceRequest
import android.widget.*
import android.graphics.Color
import android.graphics.Typeface
import android.content.Context
import android.graphics.drawable.GradientDrawable

data class Site(val name: String, val url: String)

class MainActivity : Activity() {
    private val bg = Color.rgb(247, 248, 250)
    private val ink = Color.rgb(31, 36, 44)
    private val muted = Color.rgb(112, 120, 132)
    private val blue = Color.rgb(48, 105, 210)
    private val prefs by lazy { getSharedPreferences("private_hub", Context.MODE_PRIVATE) }
    private var web: WebView? = null

    private fun defaultSites() = listOf(
        Site("MissAV", "https://missav.ws/")
    )

    private fun sites(): MutableList<Site> {
        val raw = prefs.getString("sites", null) ?: return defaultSites().toMutableList()
        return raw.split("\n").mapNotNull {
            val p = it.split("|", limit = 2)
            if (p.size == 2) Site(p[0], p[1]) else null
        }.toMutableList()
    }

    private fun saveSites(items: List<Site>) {
        prefs.edit().putString("sites", items.joinToString("\n") { "${it.name}|${it.url}" }).apply()
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        window.statusBarColor = bg
        window.navigationBarColor = Color.WHITE
        window.decorView.systemUiVisibility = View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR
        if (!prefs.getBoolean("adult_confirmed", false)) showAgeGate() else showHome()
    }

    private fun cardBg(): GradientDrawable = GradientDrawable().apply {
        setColor(Color.WHITE)
        cornerRadius = 24f
        setStroke(1, Color.rgb(232, 235, 240))
    }

    private fun baseColumn(): LinearLayout = LinearLayout(this).apply {
        orientation = LinearLayout.VERTICAL
        setBackgroundColor(bg)
    }

    private fun text(value: String, size: Float, color: Int, bold: Boolean = false): TextView =
        TextView(this).apply {
            text = value
            textSize = size
            setTextColor(color)
            if (bold) typeface = Typeface.create("sans-serif-medium", Typeface.NORMAL)
        }

    private fun showAgeGate() {
        val panel = baseColumn().apply {
            gravity = Gravity.CENTER
            setPadding(28, 28, 28, 28)
        }
        panel.addView(text("Private Hub", 30f, ink, true).apply { gravity = Gravity.CENTER })
        panel.addView(text("成人网站导航浏览器", 15f, muted).apply {
            gravity = Gravity.CENTER
            setPadding(0, 10, 0, 24)
        })
        val notice = text("本应用仅提供网站导航与浏览入口。请确认你已达到所在地法律规定的成年年龄，并仅访问合法内容。", 14f, muted)
        notice.gravity = Gravity.CENTER
        notice.setPadding(18, 22, 18, 22)
        notice.background = cardBg()
        panel.addView(notice)
        panel.addView(Button(this).apply {
            text = "我已成年，进入应用"
            setOnClickListener {
                prefs.edit().putBoolean("adult_confirmed", true).apply()
                showHome()
            }
        }, LinearLayout.LayoutParams(-1, -2).apply { topMargin = 22 })
        panel.addView(Button(this).apply {
            text = "退出"
            setOnClickListener { finish() }
        })
        setContentView(panel)
    }

    private fun showHome() {
        web = null
        val root = baseColumn()
        val scroll = ScrollView(this)
        val content = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(20, 24, 20, 24)
        }
        val top = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
        }
        val brand = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; layoutParams = LinearLayout.LayoutParams(0, -2, 1f) }
        brand.addView(text("Private Hub", 27f, ink, true))
        brand.addView(text("你常用的视频站点，集中管理", 13f, muted).apply { setPadding(0, 4, 0, 0) })
        top.addView(brand)
        top.addView(Button(this).apply {
            text = "+ 添加站点"
            setOnClickListener { showAddSiteDialog() }
        })
        content.addView(top)

        val search = EditText(this).apply {
            hint = "输入网址或搜索关键词"
            textSize = 15f
            setTextColor(ink); setHintTextColor(Color.rgb(150, 157, 168))
            singleLine = true
            setPadding(16, 14, 16, 14)
            background = cardBg()
            setOnEditorActionListener { v, _, _ ->
                val q = v.text.toString().trim()
                if (q.isNotEmpty()) openAddress(q)
                true
            }
        }
        content.addView(search, LinearLayout.LayoutParams(-1, -2).apply {
            topMargin = 24; bottomMargin = 24
        })

        val heading = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
        }
        heading.addView(text("我的站点", 19f, ink, true), LinearLayout.LayoutParams(0, -2, 1f))
        heading.addView(text("${sites().size} 个站点", 12f, muted))
        content.addView(heading)

        sites().forEachIndexed { index, site ->
            val row = LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL
                gravity = Gravity.CENTER_VERTICAL
                background = cardBg()
                setPadding(16, 12, 10, 12)
            }
            val info = LinearLayout(this).apply {
                orientation = LinearLayout.VERTICAL
                layoutParams = LinearLayout.LayoutParams(0, -2, 1f)
            }
            info.addView(text(site.name, 16f, ink, true))
            info.addView(text(site.url, 12f, muted).apply {
                maxLines = 1; ellipsize = android.text.TextUtils.TruncateAt.END
                setPadding(0, 4, 0, 0)
            })
            row.addView(info)
            row.addView(Button(this).apply {
                text = "打开"
                setOnClickListener { openAddress(site.url) }
            })
            row.addView(Button(this).apply {
                text = "⋮"
                setOnClickListener { showSiteActions(site) }
            })
            content.addView(row, LinearLayout.LayoutParams(-1, -2).apply {
                topMargin = 10
            })
        }

        val hint = text("小提示：点击「添加站点」即可保存你常用的网站。站点只保存在本机。", 12f, muted)
        hint.setPadding(2, 22, 2, 8)
        content.addView(hint)
        scroll.addView(content)
        root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1f))
        setContentView(root)
    }

    private fun showAddSiteDialog(existing: Site? = null) {
        val panel = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(20, 8, 20, 0)
        }
        val name = EditText(this).apply {
            hint = "站点名称，例如：我的视频站"
            setSingleLine(true)
            setText(existing?.name ?: "")
        }
        val url = EditText(this).apply {
            hint = "网站地址，例如：https://example.com"
            setSingleLine(true)
            setText(existing?.url ?: "")
            inputType = android.text.InputType.TYPE_TEXT_VARIATION_URI
        }
        panel.addView(name)
        panel.addView(url)
        AlertDialog.Builder(this)
            .setTitle(if (existing == null) "添加视频站点" else "编辑站点")
            .setView(panel)
            .setNegativeButton("取消", null)
            .setPositiveButton("保存") { _, _ ->
                val n = name.text.toString().trim()
                var u = url.text.toString().trim()
                if (u.isNotEmpty() && !u.startsWith("http://") && !u.startsWith("https://")) u = "https://$u"
                val uri = android.net.Uri.parse(u)
                if (n.isBlank() || (uri.scheme != "https" && uri.scheme != "http") || uri.host.isNullOrBlank()) {
                    Toast.makeText(this, "请填写站点名称和有效网址", Toast.LENGTH_LONG).show()
                    return@setPositiveButton
                }
                val all = sites()
                if (existing != null) all.removeAll { it == existing }
                all.add(Site(n, u))
                saveSites(all)
                showHome()
            }.show()
    }

    private fun showSiteActions(site: Site) {
        AlertDialog.Builder(this)
            .setTitle(site.name)
            .setItems(arrayOf("编辑", "删除")) { _, which ->
                if (which == 0) showAddSiteDialog(site)
                else AlertDialog.Builder(this).setMessage("确定删除「${site.name}」？")
                    .setNegativeButton("取消", null)
                    .setPositiveButton("删除") { _, _ ->
                        saveSites(sites().filterNot { it == site })
                        showHome()
                    }.show()
            }.show()
    }

    private fun openAddress(input: String) {
        val value = input.trim()
        val url = when {
            value.startsWith("https://") || value.startsWith("http://") -> value
            value.contains(".") && !value.contains(" ") -> "https://$value"
            else -> "https://www.google.com/search?q=" + android.net.Uri.encode(value)
        }
        val uri = android.net.Uri.parse(url)
        if ((uri.scheme != "https" && uri.scheme != "http") || uri.host.isNullOrBlank()) {
            Toast.makeText(this, "网址格式不正确", Toast.LENGTH_SHORT).show()
            return
        }
        showBrowser(url)
    }

    private fun showBrowser(url: String) {
        val page = baseColumn()
        val bar = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            setBackgroundColor(Color.WHITE)
            gravity = Gravity.CENTER_VERTICAL
        }
        bar.addView(Button(this).apply { text = "‹ 返回"; setOnClickListener { if (web?.canGoBack() == true) web?.goBack() else showHome() } })
        bar.addView(Button(this).apply { text = "首页"; setOnClickListener { showHome() } })
        bar.addView(Button(this).apply { text = "刷新"; setOnClickListener { web?.reload() } })
        page.addView(bar)
        val browser = WebView(this)
        web = browser
        browser.settings.javaScriptEnabled = true
        browser.settings.domStorageEnabled = true
        browser.settings.mediaPlaybackRequiresUserGesture = true
        browser.settings.allowFileAccess = false
        browser.settings.allowContentAccess = false
        browser.webViewClient = object : WebViewClient() {
            override fun shouldOverrideUrlLoading(view: WebView?, request: WebResourceRequest?): Boolean {
                val scheme = request?.url?.scheme ?: return true
                return scheme != "https" && scheme != "http"
            }
        }
        browser.webChromeClient = WebChromeClient()
        CookieManager.getInstance().setAcceptCookie(true)
        page.addView(browser, LinearLayout.LayoutParams(-1, 0, 1f))
        setContentView(page)
        browser.loadUrl(url)
    }

    @Deprecated("Deprecated in Android")
    override fun onBackPressed() {
        if (web?.canGoBack() == true) web?.goBack() else showHome()
    }

    override fun onDestroy() {
        web?.apply { stopLoading(); loadUrl("about:blank"); clearHistory(); removeAllViews(); destroy() }
        web = null
        super.onDestroy()
    }
}

